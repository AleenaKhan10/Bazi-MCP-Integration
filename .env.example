# ================================================
# BaZi MCP — Environment Variables
# ================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Docker Compose reads this .env automatically.

# Claude API Key (REQUIRED for report generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Resend Email API Key (OPTIONAL — for emailing reports)
RESEND_API_KEY=
